{
    "name": "quiz",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=24.14.1 <25"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.core.json",
        "lint": "eslint src tests/core tests/types vite.config.ts --max-warnings 0",
        "test": "node --test tests/*.mjs tests/core/*.test.ts scripts/check-types.test.mjs",
        "check": "npm run typecheck && npm run lint && npm test && npm run build",
        "cli": "node cli.mjs"
    },
    "overrides": {
        "eslint": {
            "minimatch": "11.0.1"
        },
        "@eslint/config-array": {
            "minimatch": "11.0.1"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "11.0.1"
        }
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.2",
        "eslint": "10.14.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6"
    }
}
